# 盆栽マッチング 設定の見本（値は空のまま共有する）
# 使うときは、このファイルを .env という名前で写し、値を入れる。.env は GitHub に上げない
#   cp .env.example .env && chmod 600 .env

# Claude API の鍵（入れると本物のAIで動く。使った分の料金がかかる）
ANTHROPIC_API_KEY=

# 開くための合言葉（公開するときは必ず入れる）
ACCESS_PASSWORD=

# AIの回数の上限（空なら 全体で1日200回・1人で1日12回。盆栽ゴー_料金の守り.mjs）
AI_DAILY_LIMIT=
AI_USER_LIMIT=
# 同じ回線（IP）から1日に呼べる回数（空なら60回）。ログインしていない人の職人登録もここで数える
AI_IP_LIMIT=

# 鍵がワークスペースに属していないときだけ入れる（Claude Console の Workspaces に出る wrkspc_ で始まる番号）
ANTHROPIC_WORKSPACE_ID=

# 使うモデル（空なら 確かめ＝claude-haiku-5-5・書く＝claude-sonnet-5-5・やり直し＝claude-opus-5-5）。前の BONSAI_MODEL は使わない
BONSAI_MODEL_CHECK=
BONSAI_MODEL_MAIN=
BONSAI_MODEL_FALLBACK=

# 見本の職人（名.姓@bonsaigo.example）でログインするときの共通パスワード。コードには書かない。空なら見本の職人ではログインできない
BONSAI_DEMO_PASSWORD=

# 管理者ページ（/盆栽ゴー/管理.html）のパスワード。職人が登録した木を一覧で見て、公式の X と Instagram に出す。空なら管理者は入れない
BONSAI_ADMIN_PASSWORD=

# デモ動画用の見本のユーザー（盆栽ゴー_デモ用の見本.mjs）。4つとも入っているときだけ動く。
# ログイン画面にはメールアドレスだけが最初から入る。パスワードは画面に送らないので、撮影のときに手で打つ。本物とは別の値にする
# 相談する人（見本の Emma）
BONSAIGO_DEMO_ASKER_EMAIL=
BONSAIGO_DEMO_ASKER_PASSWORD=
# 職人（大宮の園の園主 青木 義郎）
BONSAIGO_DEMO_CRAFT_EMAIL=
BONSAIGO_DEMO_CRAFT_PASSWORD=
