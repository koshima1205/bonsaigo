# 盆栽マッチング 設定の見本（値は空のまま共有する）
# 使うときは、このファイルを .env という名前で写し、値を入れる。.env は GitHub に上げない
#   cp .env.example .env && chmod 600 .env

# Claude API の鍵（入れると本物のAIで動く。使った分の料金がかかる）
ANTHROPIC_API_KEY=

# 開くための合言葉（公開するときは必ず入れる）
ACCESS_PASSWORD=

# AIの回数の上限（空なら 全体で1日300回・1人で1日60回）
AI_DAILY_LIMIT=
AI_USER_LIMIT=
# 同じ回線（IP）から1日に呼べる回数（空なら120回）。ログインしていない人の職人登録もここで数える
AI_IP_LIMIT=
